{
  "name": "siteflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/embed-migrations.mjs && prisma generate && next build",
    "start": "node scripts/start.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "site:export": "tsx scripts/export-site.ts",
    "site:import": "tsx scripts/import-site.ts",
    "typecheck": "node scripts/embed-migrations.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "next": "16.4.4",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
