# Copier ce fichier en .env et remplir les valeurs

# Base MySQL (hébergement : toujours 127.0.0.1, jamais localhost)
DATABASE_URL="mysql://siteflow:MOT_DE_PASSE@127.0.0.1:3306/siteflow"

# Clé secrète des sessions (générer : openssl rand -hex 32)
SESSION_SECRET="changer-cette-cle-secrete-longue"

# Domaine(s) du Studio (séparés par des virgules). Tout autre domaine = site client.
STUDIO_HOSTS="studio.flowtechnologie.ma,localhost:3000,localhost"



# Port (local uniquement ; l'hébergeur le fournit)
PORT=3020

# Compte superadmin créé automatiquement au premier démarrage (base vide)
SEED_ADMIN_EMAIL="admin@flowtechnologie.ma"
SEED_ADMIN_PASSWORD="ChangezMoi!2026"

# Mode site autonome (export) : laisser vide sur le Studio.
# Si renseigné, l'application ne sert QUE ce site et son admin sur /admin.
SINGLE_SITE_SLUG=""
